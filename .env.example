# Copy to apps/server/.env and adjust for your environment.
# Values below are ASSUMPTIONS documented in docs/ENVIRONMENT_ANALYSIS.md —
# verify them against the real Windows Server 2019 + XAMPP installation
# before running the setup wizard.

NODE_ENV=development
PORT=4000

# SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Session / auth
SESSION_SECRET=change-me-to-a-long-random-string
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS - the web app's origin (adjust for production)
WEB_ORIGIN=http://localhost:5173

# Apache (defaults assumed for XAMPP on Windows Server 2019 - CHANGE via
# the Settings screen or here before first use)
APACHE_ROOT_PATH=D:\xampp\apache
APACHE_EXECUTABLE_PATH=D:\xampp\apache\bin\httpd.exe
APACHE_VHOSTS_PATH=D:\xampp\apache\conf\extra\httpd-vhosts.conf
APACHE_MANAGED_SITES_PATH=D:\xampp\apache\conf\mw-sites
APACHE_BACKUP_PATH=D:\xampp\apache\conf\mw-backups
SSL_CERTIFICATE_PATH=D:\certs\roboworks_wildcard\_.roboworks.co.kr-crt.pem
SSL_CERTIFICATE_KEY_PATH=D:\certs\roboworks_wildcard\_.roboworks.co.kr-key.pem
DEFAULT_DOMAIN_SUFFIX=roboworks.co.kr
DEFAULT_HEALTH_CHECK_TIMEOUT_MS=3000

# Set to "mock" in local development / CI where the real httpd.exe is not
# available. Set to "real" only on the actual Windows Server host.
APACHE_COMMAND_RUNNER=mock
# Only used when APACHE_COMMAND_RUNNER=mock: simulate Apache as running (true)
# or unreachable (false), to exercise the apply/rollback paths locally.
APACHE_MOCK_PROCESS_RUNNING=true
